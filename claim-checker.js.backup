// Configuration
const CONFIG = {
    RPC_URL: 'https://evmrpc.0g.ai', // 0G Mainnet RPC
    CLAIM_CONTRACT_ADDRESS: '0x6a9c6b5507e322aa00eb9c45e80c07ab63acabb6', // MilestoneClaim on 0G
    NFT_CONTRACT_ADDRESS: '0xd0f4e1265edd221b5bb0e8667a59f31b587b2197', // NFT on Arbitrum (optional)
    CONTRACT_ABI: [
        {
            name: "allocationPerToken",
            type: "function",
            inputs: [],
            outputs: [{ name: "", type: "uint256", internalType: "uint256" }],
            stateMutability: "view",
        },
        {
            name: "init_unlock",
            type: "function",
            inputs: [],
            outputs: [{ name: "", type: "uint256", internalType: "uint256" }],
            stateMutability: "view",
        },
        {
            name: "partPercentage",
            type: "function",
            inputs: [],
            outputs: [{ name: "", type: "uint256", internalType: "uint256" }],
            stateMutability: "view",
        },
        {
            name: "curPenalty",
            type: "function",
            inputs: [],
            outputs: [{ name: "", type: "uint256", internalType: "uint256" }],
            stateMutability: "view",
        },
        {
            name: "claimData",
            type: "function",
            inputs: [{ name: "credential", type: "uint256", internalType: "uint256" }],
            outputs: [
                { name: "consumed", type: "uint256", internalType: "uint256" },
                { name: "claimed", type: "uint256", internalType: "uint256" },
            ],
            stateMutability: "view",
        },
        {
            name: "resolve",
            type: "function",
            inputs: [{ name: "_credential", type: "uint256", internalType: "uint256" }],
            outputs: [{ name: "", type: "address", internalType: "address" }],
            stateMutability: "view",
        },
        {
            name: "calculateAmount",
            type: "function",
            inputs: [
                { name: "_amount", type: "uint256", internalType: "uint256" },
                { name: "_penalty", type: "uint256", internalType: "uint256" },
                { name: "_consumed", type: "uint256", internalType: "uint256" },
                { name: "baseline", type: "uint256", internalType: "uint256" },
            ],
            outputs: [{ name: "", type: "uint256", internalType: "uint256" }],
            stateMutability: "view",
        },
        {
            name: "milestonesCount",
            type: "function",
            inputs: [],
            outputs: [{ name: "", type: "uint256", internalType: "uint256" }],
            stateMutability: "view",
        },
        {
            name: "milestones",
            type: "function",
            inputs: [{ name: "milestoneIdx", type: "uint256", internalType: "uint256" }],
            outputs: [
                { name: "timestamp", type: "uint256", internalType: "uint256" },
                { name: "penalty", type: "uint256", internalType: "uint256" },
            ],
            stateMutability: "view",
        },
    ]
};

// Global variables
let provider;
let contract;

// Initialize provider and contract
async function init() {
    try {
        provider = new ethers.providers.JsonRpcProvider(CONFIG.RPC_URL);
        contract = new ethers.Contract(CONFIG.CLAIM_CONTRACT_ADDRESS, CONFIG.CONTRACT_ABI, provider);
        console.log('Provider and contract initialized successfully');
        console.log('Connected to 0G Mainnet');
    } catch (error) {
        console.error('Initialization error:', error);
        throw error;
    }
}

// Format ether values
function formatEther(value) {
    return ethers.utils.formatEther(value);
}

// Format number with commas
function formatNumber(num) {
    const numStr = parseFloat(num).toFixed(2);
    return numStr.replace(/\B(?=(\d{3})+(?!\d))/g, ",");
}

// Format date
function formatDate(timestamp) {
    const date = new Date(timestamp * 1000);
    return date.toLocaleDateString('en-US', {
        year: 'numeric',
        month: 'short',
        day: 'numeric'
    });
}

// Show loading state
function showLoading() {
    document.getElementById('loading').classList.add('active');
    document.getElementById('error').classList.remove('active');
    document.getElementById('results').classList.remove('active');
    document.getElementById('searchButton').disabled = true;
}

// Hide loading state
function hideLoading() {
    document.getElementById('loading').classList.remove('active');
    document.getElementById('searchButton').disabled = false;
}

// Show error
function showError(message) {
    const errorEl = document.getElementById('error');
    errorEl.textContent = message;
    errorEl.classList.add('active');
    hideLoading();
}

// Show results
function showResults() {
    document.getElementById('results').classList.add('active');
    hideLoading();
}

// Get NFT claim data
async function getNFTClaimData(nftId) {
    try {
        showLoading();

        console.log(`Fetching data for NFT ID: ${nftId}`);

        // Fetch only the data that works (matching the hardhat task)
        const [
            allocationPerToken,
            initUnlock,
            partPercentage,
            currentPenalty,
            claimData
        ] = await Promise.all([
            contract.allocationPerToken(),
            contract.init_unlock(),
            contract.partPercentage(),
            contract.curPenalty(),
            contract.claimData(nftId)
        ]);

        console.log('Contract data fetched:', {
            allocationPerToken: allocationPerToken.toString(),
            initUnlock: initUnlock.toString(),
            partPercentage: partPercentage.toString(),
            currentPenalty: currentPenalty.toString(),
            consumed: claimData.consumed.toString(),
            claimed: claimData.claimed.toString()
        });

        // Hardcode milestone schedule (from official blog post)
        // Part 1 claim started on September 21, 2025
        const TGE_TIMESTAMP = 1758412800; // Sep 21, 2025 00:00:00 GMT
        const milestones = [
            {
                timestamp: TGE_TIMESTAMP,
                penalty: ethers.utils.parseEther('0.6') // 60%
            },
            {
                timestamp: TGE_TIMESTAMP + (90 * 24 * 60 * 60), // Dec 20, 2025
                penalty: ethers.utils.parseEther('0.5') // 50%
            },
            {
                timestamp: TGE_TIMESTAMP + (180 * 24 * 60 * 60), // Mar 20, 2026
                penalty: ethers.utils.parseEther('0.35') // 35%
            },
            {
                timestamp: TGE_TIMESTAMP + (270 * 24 * 60 * 60), // Jun 18, 2026
                penalty: ethers.utils.parseEther('0.2') // 20%
            },
            {
                timestamp: TGE_TIMESTAMP + (365 * 24 * 60 * 60), // Sep 21, 2026
                penalty: ethers.utils.parseEther('0') // 0%
            }
        ];

        const ONE_ETHER = ethers.utils.parseEther('1');

        // Parse claim data
        const consumed = claimData.consumed;
        const claimed = claimData.claimed;

        // Calculate Part 1 values
        const baseline = allocationPerToken.mul(initUnlock).div(ONE_ETHER);
        const part1Total = allocationPerToken.mul(partPercentage).div(ONE_ETHER);
        const part1RemainingShare = part1Total.sub(consumed);

        // Calculate max claimable amount (with current penalty)
        let part1RemainingClaimable;
        if (part1RemainingShare.lte(0)) {
            part1RemainingClaimable = ethers.BigNumber.from(0);
        } else {
            try {
                part1RemainingClaimable = await contract.calculateAmount(
                    part1RemainingShare,
                    currentPenalty,
                    consumed,
                    baseline
                );
            } catch (error) {
                console.warn('Could not calculate claimable amount:', error);
                part1RemainingClaimable = ethers.BigNumber.from(0);
            }
        }

        // Calculate Part 2 values
        const part2Percentage = ONE_ETHER.sub(partPercentage);
        const part2Total = allocationPerToken.mul(part2Percentage).div(ONE_ETHER);
        const part2DailyRate = part2Total.div(ethers.BigNumber.from(36 * 30)); // Approximate daily rate

        // Display all data
        displayNFTData({
            nftId,
            allocationPerToken,
            currentPenalty,
            part1: {
                total: part1Total,
                penaltyFree: baseline,
                consumed,
                claimed,
                remainingShare: part1RemainingShare,
                remainingClaimable: part1RemainingClaimable
            },
            part2: {
                total: part2Total,
                dailyRate: part2DailyRate
            },
            milestones
        });

        showResults();
    } catch (error) {
        console.error('Error fetching NFT data:', error);
        if (error.message.includes('invalid BigNumber string')) {
            showError('Invalid NFT ID. Please enter a valid number.');
        } else if (error.message.includes('could not detect network')) {
            showError('Could not connect to 0G Network. Please check your internet connection.');
        } else {
            showError(`Error: ${error.message || 'Failed to fetch NFT data. The NFT might not exist.'}`);
        }
    }
}

// Display NFT data
function displayNFTData(data) {
    // NFT Info
    document.getElementById('nftId').textContent = data.nftId;
    // Show link to check owner on OpenSea/Arbiscan
    const ownerEl = document.getElementById('ownerAddress');
    ownerEl.innerHTML = `<a href="https://opensea.io/assets/arbitrum/0xd0f4e1265edd221b5bb0e8667a59f31b587b2197/${data.nftId}" target="_blank" style="color: #667eea; text-decoration: underline;">View on OpenSea</a>`;
    document.getElementById('totalAllocation').textContent = formatNumber(formatEther(data.allocationPerToken)) + ' 0G';
    const penaltyPercent = (parseFloat(formatEther(data.currentPenalty)) * 100).toFixed(0);
    document.getElementById('currentPenalty').textContent = penaltyPercent + '%';

    // Part 1 Data
    document.getElementById('part1Total').textContent = formatNumber(formatEther(data.part1.total)) + ' 0G';
    document.getElementById('part1PenaltyFree').textContent = formatNumber(formatEther(data.part1.penaltyFree)) + ' 0G';
    document.getElementById('part1Consumed').textContent = formatNumber(formatEther(data.part1.consumed)) + ' 0G';
    document.getElementById('part1Claimed').textContent = formatNumber(formatEther(data.part1.claimed)) + ' 0G';

    // Check if there's any remaining claim
    if (data.part1.remainingShare.eq(0)) {
        document.getElementById('part1RemainingShare').innerHTML = '<span style="color: #999;">No claim left</span>';
        document.getElementById('part1RemainingClaimable').innerHTML = '<span style="color: #999;">No claim left</span>';
    } else {
        document.getElementById('part1RemainingShare').textContent = formatNumber(formatEther(data.part1.remainingShare)) + ' 0G';
        document.getElementById('part1RemainingClaimable').textContent = formatNumber(formatEther(data.part1.remainingClaimable)) + ' 0G';
    }

    // Part 2 Data
    document.getElementById('part2Total').textContent = formatNumber(formatEther(data.part2.total)) + ' 0G';
    document.getElementById('part2DailyRate').textContent = '~' + formatNumber(formatEther(data.part2.dailyRate)) + ' 0G/day';

    // Milestones Table - pass remaining share and baseline for calculations
    displayMilestones(data.milestones, data.currentPenalty, data.part1.remainingShare, data.part1.consumed, data.part1.penaltyFree);
}

// Display milestones with claimable amounts
function displayMilestones(milestones, currentPenalty, remainingShare, consumed, baseline) {
    const tbody = document.getElementById('milestoneTableBody');
    tbody.innerHTML = '';

    const now = Math.floor(Date.now() / 1000);
    const tgeDate = milestones.length > 0 ? milestones[0].timestamp : now;

    milestones.forEach((milestone, index) => {
        const row = document.createElement('tr');
        const isCurrent = milestone.penalty.eq(currentPenalty);
        const isPast = now > milestone.timestamp;
        const isFuture = now < milestone.timestamp;

        if (isCurrent) {
            row.classList.add('current');
        }

        const daysFromTGE = Math.floor((milestone.timestamp - tgeDate) / (24 * 60 * 60));
        const penaltyPercent = (parseFloat(formatEther(milestone.penalty)) * 100).toFixed(0);

        let statusBadge = '';
        if (isCurrent) {
            statusBadge = '<span class="badge current">Current</span>';
        } else if (isPast) {
            statusBadge = '<span class="badge past">Past</span>';
        } else {
            statusBadge = '<span class="badge future">Upcoming</span>';
        }

        // Calculate claimable amount at this milestone
        let claimableText = '-';
        let receiveText = '-';

        if (remainingShare.gt(0)) {
            try {
                // Calculate what they'd get after penalty at this milestone
                const receiveAmount = calculatePenaltyAdjustedAmount(remainingShare, milestone.penalty, consumed, baseline);
                claimableText = formatNumber(formatEther(remainingShare)) + ' 0G';
                receiveText = formatNumber(formatEther(receiveAmount)) + ' 0G';
            } catch (e) {
                claimableText = formatNumber(formatEther(remainingShare)) + ' 0G';
                receiveText = 'Error calculating';
            }
        } else {
            claimableText = 'No claim left';
            receiveText = 'No claim left';
        }

        row.innerHTML = `
            <td>${formatDate(milestone.timestamp)}</td>
            <td>${daysFromTGE} days</td>
            <td>${penaltyPercent}%</td>
            <td>${statusBadge}</td>
            <td>${claimableText}</td>
            <td><strong>${receiveText}</strong></td>
        `;

        tbody.appendChild(row);
    });
}

// Calculate penalty-adjusted amount (simplified version)
function calculatePenaltyAdjustedAmount(amount, penalty, consumed, baseline) {
    const ONE_ETHER = ethers.utils.parseEther('1');

    // Simple penalty calculation: amount * (1 - penalty)
    // For amounts above baseline, apply penalty to the excess
    const penaltyMultiplier = ONE_ETHER.sub(penalty);

    if (consumed.add(amount).lte(baseline)) {
        // All within penalty-free zone
        return amount;
    } else if (consumed.gte(baseline)) {
        // All above baseline, apply penalty
        return amount.mul(penaltyMultiplier).div(ONE_ETHER);
    } else {
        // Partially in penalty-free zone
        const penaltyFreeAmount = baseline.sub(consumed);
        const penaltyAmount = amount.sub(penaltyFreeAmount);
        const penaltyAdjusted = penaltyAmount.mul(penaltyMultiplier).div(ONE_ETHER);
        return penaltyFreeAmount.add(penaltyAdjusted);
    }
}

// Handle form submission
document.getElementById('searchForm').addEventListener('submit', async (e) => {
    e.preventDefault();
    const nftId = document.getElementById('nftIdInput').value.trim();

    if (!nftId || isNaN(nftId)) {
        showError('Please enter a valid NFT ID (numbers only).');
        return;
    }

    await getNFTClaimData(nftId);
});

// Initialize on page load (wait for all scripts to load)
window.addEventListener('load', async () => {
    try {
        // Wait a bit to ensure ethers is fully loaded
        if (typeof ethers === 'undefined') {
            throw new Error('Ethers.js library failed to load');
        }
        await init();
        console.log('Application initialized successfully');
    } catch (error) {
        console.error('Failed to initialize application:', error);
        showError('Failed to initialize application. Please refresh the page.');
    }
});
